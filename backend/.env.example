# Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Stellar testnet (required)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_PASSPHRASE=Test SDF Network ; September 2015

# TR Mock Anchor (SEP-6, not SEP-24)
TR_ANCHOR_DOMAIN=tr-mock-anchor.fly.dev
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Optional: enables testnet-only demo signing endpoints (never commit real secrets)
DEMO_SIGNER_ENABLED=false
DEMO_SIGNER_SECRET=

# Trinqa allocation policy (defaults from ../deployments/testnet.json)
TRINQA_POLICY_CONTRACT_ID=
POLICY_CONTRACT_ID=
POLICY_WASM_HASH=

# DeFindex — server-side partner API key (never expose to mobile)
DEFINDEX_API_KEY=
DEFINDEX_API_URL=https://api.defindex.io
# Vault must include Trinqa testnet USDC SAC (see pnpm hackathon:compat)
DEFINDEX_VAULT_ADDRESS=

# Soroswap — server-side partner API key (Node 22+)
SOROSWAP_API_KEY=
SOROSWAP_API_URL=https://api.soroswap.finance

# Local operation persistence (optional)
OPERATIONS_DATA_DIR=

{
  "name": "@trinqa/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "toml": "4.3.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "pnpm build && vitest run",
    "e2e:anchor": "tsx ../scripts/e2e-anchor.ts",
    "e2e:policy": "tsx ../scripts/e2e-policy.ts",
    "e2e:defindex": "tsx ../scripts/e2e-defindex.ts",
    "e2e:soroswap": "tsx ../scripts/e2e-soroswap.ts",
    "e2e:trinqa": "tsx ../scripts/e2e-trinqa.ts"
  },
  "dependencies": {
    "@defindex/sdk": "^0.3.0",
    "@fastify/cors": "^11.0.1",
    "@soroswap/sdk": "^0.5.0",
    "@stellar/stellar-sdk": "^14.1.0",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "toml": "^4.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}

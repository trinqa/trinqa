# Trinqa mobile — public config only. Never put Stellar secrets, anchor JWTs,
# DeFindex keys, or Soroswap keys here.

# Backend BFF. Required in production builds. Dev falls back to 127.0.0.1:8787.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# Optional Stellar G-address. If empty, mobile uses GET /api/v1/demo/account
# when the backend demo signer is enabled.
EXPO_PUBLIC_ACCOUNT_ID=

# Optional USDC payment recipient G-address. Defaults to the session account.
EXPO_PUBLIC_PAY_RECIPIENT=

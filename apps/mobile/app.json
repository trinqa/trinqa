{
  "expo": {
    "name": "Trinqa",
    "slug": "trinqa",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "trinqa",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trinqa.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F2"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.trinqa.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
